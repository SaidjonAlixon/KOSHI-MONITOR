# KOSHI — environment variables (copy to .env or /etc/koshi/koshi.env; NEVER commit real values)
# All API settings can be overridden with the KOSHI_ prefix and "__" as section separator.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5090

# PostgreSQL (dedicated role/database for KOSHI)
KOSHI_DB_PASSWORD=change-me
KOSHI_ConnectionStrings__Koshi=Host=127.0.0.1;Port=5432;Database=koshi;Username=koshi;Password=change-me

# JWT signing key: at least 32 random bytes (e.g. `openssl rand -base64 48`)
KOSHI_Jwt__SigningKey=change-me-to-a-long-random-value

# First Super Admin (created only when the Users table is empty). Password policy: >=12 chars, 3 of 4 classes.
KOSHI_Bootstrap__AdminEmail=admin@example.com
KOSHI_Bootstrap__AdminPassword=change-me

# Reverse proxy (nginx) on the same host
KOSHI_Network__KnownProxies__0=127.0.0.1

# Migrations: prefer running the migration bundle during deployment instead of on startup
KOSHI_Database__ApplyMigrationsOnStartup=false
