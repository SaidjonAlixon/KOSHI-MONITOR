{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Koshi": ""
  },
  "Jwt": {
    "Issuer": "koshi-api",
    "Audience": "koshi-admin",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 7,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "CookieSecure": true
  },
  "Security": {
    "PasswordHashIterations": 600000
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Bootstrap": {
    "SeedDemoData": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "GlobalPerMinute": 600,
    "LoginPerMinute": 10,
    "ActivationPerMinute": 10,
    "DevicePerMinute": 120,
    "DeviceBurst": 60
  },
  "Network": {
    "TrustAllProxies": false,
    "KnownProxies": [],
    "UseHsts": true,
    "HttpsRedirection": false
  },
  "Maintenance": {
    "Enabled": true,
    "OfflineCheckMinutes": 5,
    "RetentionHours": 6
  },
  "OpenApi": {
    "Enabled": false
  }
}
