<Window x:Class="KOSHI.Agent.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KOSHI — Tizim yangilanishi"
        Icon="pack://application:,,,/Assets/koshi.ico"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="White"
        FontFamily="Segoe UI">
    <StackPanel>
        <Border Height="6" Background="{StaticResource BrandGradient}" />
        <StackPanel Margin="24,20,24,22">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/koshi-icon.png" Width="36" Height="36" VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Tizimda yangilanish mavjud!" FontWeight="SemiBold" FontSize="15" Foreground="#0B1226" />
                    <TextBlock x:Name="VersionInfoText" FontSize="12" Foreground="#4F46E5" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="#334155"
                       Text="KOSHI dasturining yangi versiyasi chiqdi. Yangi imkoniyatlar va tuzatishlar ishlashi uchun dasturni hozir yangilang." />

            <StackPanel x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
                <ProgressBar x:Name="DownloadBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#4F46E5" />
                <TextBlock x:Name="StatusLabel" Margin="0,6,0,0" FontSize="11.5" Foreground="#475569" Text="Yuklanmoqda…" />
            </StackPanel>

            <TextBlock x:Name="ErrorLabel" Margin="0,10,0,0" FontSize="11.5" Foreground="#DC2626" TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="LaterBtn" Content="Keyinroq" Padding="14,7" Margin="0,0,8,0" Click="OnLater"
                        Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Cursor="Hand" />
                <Button x:Name="UpdateBtn" Content="Yangilash" Padding="18,7" Click="OnUpdate"
                        Background="#4F46E5" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
