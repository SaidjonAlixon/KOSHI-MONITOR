<Window x:Class="KOSHI.Agent.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KOSHI Agent"
        Icon="pack://application:,,,/Assets/koshi.ico"
        Width="480" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Segoe UI">
    <StackPanel>
        <Border Height="6" Background="{StaticResource BrandGradient}" />
        <StackPanel Margin="28,20,28,8" HorizontalAlignment="Left">
            <!-- PNG glow leaves ~40px empty on the left; pull it back so the K lines up with the tagline. -->
            <Image Source="pack://application:,,,/Assets/koshi-logo.png"
                   Height="46" Stretch="Uniform" HorizontalAlignment="Left" Margin="-24,0,0,0"
                   RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Muted}" FontSize="13"
                       Text="Aqlli monitoring. Ishonchli nazorat." />
        </StackPanel>

        <Border x:Name="UpdateBanner" Margin="28,8,28,0" Padding="14,10" CornerRadius="10" Background="#EEF1FF" BorderBrush="#C7D2FE" BorderThickness="1" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateBannerTitle" Text="Yangi yangilanish mavjud!" FontWeight="SemiBold" FontSize="12.5" Foreground="#3730A3" />
                    <TextBlock x:Name="UpdateBannerSub" Text="Yangilash tugmasini bosing" FontSize="11" Foreground="#4338CA" />
                </StackPanel>
                <Button Grid.Column="1" Content="Yangilash" Padding="14,6" VerticalAlignment="Center" Click="OnUpdateBannerClick"
                        Background="#4F46E5" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
            </Grid>
        </Border>

        <StackPanel x:Name="StatusSection" Margin="28,12,28,0">
            <Border x:Name="StatusBox" Padding="14,10" CornerRadius="10" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusDetail" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
            </Border>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Agent versiyasi:" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionText" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="Yangilanish holati:" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock x:Name="AutoUpdateText" FontSize="12" VerticalAlignment="Center" />
                    <Button x:Name="CheckUpdateBtn" Content="Tekshirish" Margin="8,0,0,0" Padding="8,2" FontSize="11" Click="OnCheckUpdateClick"
                            Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" />
                </StackPanel>
            </Grid>
            <Border x:Name="LicensePanel" Margin="0,12,0,0" Padding="10,8" CornerRadius="10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LicenseTitle" Text="Aktivatsiya tugashiga" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                    <Border Grid.Column="1" x:Name="LicenseChip" CornerRadius="8" Padding="9,3" Background="#EEF1FF" BorderBrush="#C7D2FE" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock x:Name="LicenseValue" Text="—" FontSize="12" FontWeight="SemiBold" FontFamily="Consolas" Foreground="#4338CA" />
                    </Border>
                </Grid>
            </Border>
            <Button x:Name="ActivateButton" Margin="0,12,0,0" Padding="12,6" HorizontalAlignment="Left" Content="Qurilmani aktivatsiya qilish…"
                    Click="OnActivate" Visibility="Collapsed" Background="#2F80FF" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel x:Name="SupportSection" Margin="28,16,28,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Texnik yordam — administrator bilan chat" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" />
                <Button Grid.Column="1" Content="Alohida oynada ochish ↗" Padding="10,4" FontSize="11.5" Click="OnOpenChatWindow"
                        Background="#EEF1FF" Foreground="#4338CA" BorderBrush="#C7D2FE" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" />
            </Grid>
            <Border Margin="0,8,0,0" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Background="#F8FAFC">
                <ScrollViewer x:Name="ChatScroll" Height="110" VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <StackPanel x:Name="ChatList" />
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="TypingText" Margin="0,4,0,0" Text="Administrator yozmoqda…" FontSize="11" FontStyle="Italic" Foreground="#4F46E5" Visibility="Collapsed" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ChatInput" Padding="8" FontSize="12" KeyDown="OnChatKeyDown" TextChanged="OnChatTextChanged" />
                <Button Grid.Column="1" Content="Yuborish" Margin="8,0,0,0" Padding="12,0" Click="OnChatSend"
                        Background="#4F46E5" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
            </Grid>
        </StackPanel>
    </StackPanel>
</Window>
