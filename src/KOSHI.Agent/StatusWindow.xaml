<Window x:Class="KOSHI.Agent.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KOSHI Agent"
        Icon="pack://application:,,,/Assets/koshi.ico"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Segoe UI">
    <StackPanel>
        <Border Height="6" Background="{StaticResource BrandGradient}" />
        <StackPanel Margin="28,24,28,8">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/koshi-icon.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                <Image Source="pack://application:,,,/Assets/koshi-logo.png" Height="30" Margin="14,0,0,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            </StackPanel>
            <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Muted}" FontSize="12"
                       Text="Korporativ kompyuter monitoringi agenti" />
        </StackPanel>

        <StackPanel x:Name="StatusSection" Margin="28,12,28,0">
            <TextBlock Text="Holat" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" />
            <Border Margin="0,8,0,0" Padding="14,10" CornerRadius="10" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="StatusText" FontWeight="SemiBold" Foreground="#9A3412" Text="Monitoring ishga tushirilmagan" />
                    <TextBlock x:Name="StatusDetail" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#7C2D12"
                               Text="Agent hali serverga ulanmagan va aktivatsiya qilinmagan. Ma'lumot yig'ilmayapti." />
                </StackPanel>
            </Border>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Server:" Foreground="{StaticResource Muted}" FontSize="12" />
                <TextBlock x:Name="ServerText" Grid.Column="1" Text="sozlanmagan" FontSize="12" />
                <TextBlock Grid.Row="1" Text="Agent versiyasi:" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                <TextBlock x:Name="VersionText" Grid.Row="1" Grid.Column="1" FontSize="12" Margin="0,4,0,0" />
            </Grid>
        </StackPanel>

        <StackPanel x:Name="PolicySection" Margin="28,18,28,0">
            <TextBlock Text="Monitoring siyosati" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Ink}"
                       Text="Bu kompyuter tashkilot siyosatiga muvofiq monitoring qilinishi mumkin: faol dastur nomi, faol/bo'sh vaqt va (siyosat ruxsat bersa) maskalangan oyna sarlavhasi. Klaviatura bosishlari, parollar, clipboard, kamera, mikrofon va shaxsiy xabarlar yig'ilmaydi." />
        </StackPanel>

        <StackPanel x:Name="SupportSection" Margin="28,18,28,24">
            <TextBlock Text="Texnik yordam" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Ink}"
                       Text="Savollar, monitoringni o'chirish yoki agentni rasmiy olib tashlash uchun tashkilotingiz IT bo'limiga murojaat qiling." />
        </StackPanel>
    </StackPanel>
</Window>
