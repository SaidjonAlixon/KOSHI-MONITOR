<Window x:Class="KOSHI.Agent.Remote.AppLockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KOSHI — Dastur qulflangan"
        Icon="pack://application:,,,/Assets/koshi.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Background="#D90B1226"
        FontFamily="Segoe UI">
    <Grid>
        <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.45" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <Border Height="6" CornerRadius="16,16,0,0" Background="{StaticResource BrandGradient}" />
                <StackPanel Margin="26,22,26,24">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/koshi-icon.png" Width="36" Height="36" VerticalAlignment="Center" />
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="16" Foreground="#0B1226" TextWrapping="Wrap" MaxWidth="310" />
                            <TextBlock x:Name="SubtitleText" Text="Kirish parol bilan cheklangan" FontSize="11.5" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="DescriptionText" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="#334155"
                               Text="Bu dastur administrator tomonidan parol bilan himoyalangan. Dasturni ochish uchun parolni kiriting, aks holda dastur yopiladi." />

                    <Grid Margin="0,14,0,0">
                        <PasswordBox x:Name="PasswordInput" Padding="10,8" FontSize="14" PasswordChanged="OnPasswordChanged" />
                        <TextBox x:Name="PasswordPlain" Padding="10,8" FontSize="14" Visibility="Collapsed" TextChanged="OnPlainChanged" />
                    </Grid>

                    <CheckBox x:Name="ShowPwd" Margin="2,8,0,0" Content="Parolni ko‘rsatish" FontSize="12" Foreground="#475569"
                              Checked="OnToggleShow" Unchecked="OnToggleShow" />

                    <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Foreground="#DC2626" FontWeight="SemiBold" FontSize="12" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Yopish (Bekor qilish)" Padding="14,8" Margin="0,0,8,0" IsCancel="True" Click="OnCancel"
                                Background="#F1F5F9" Foreground="#334155" BorderThickness="0" Cursor="Hand" />
                        <Button x:Name="OkButton" Content="Ochish" Padding="20,8" IsDefault="True" Click="OnOk"
                                Background="#4F46E5" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
